# Local fallback (slow on CPU / unified-memory machines)
PHONE_MODEL_PROVIDER=ollama
PHONE_MODEL_BASE_URL=http://127.0.0.1:11434/api/chat
PHONE_MODEL_NAME=qwen3-vl:4b
PHONE_MODEL_API_KEY=

