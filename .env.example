ANDROID_SERIAL=
SCRCPY_PATH=scrcpy
ADB_PATH=adb
SHADOW_WIDTH=1080
SHADOW_HEIGHT=2400
SHADOW_DPI=420
BROWSER_PACKAGE=
NOTES_PACKAGE=
ACCESSIBILITY_BRIDGE_AUTHORITY=com.bearbless.bridge.control
BEARBLESS_WHISPER_MODEL=tiny
